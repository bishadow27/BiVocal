<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiVoca"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.home.HomeActivity"
            android:theme="@style/Theme.BiVoca.Home.Approved"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsDetailActivity"
            android:exported="false" />

        <receiver
            android:name=".settings.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.BiVoca.Login.Reference"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.BiVoca.Login.Reference"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.BiVoca.Login.Approved"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <activity
            android:name=".ui.topics.TopicsActivity"
            android:theme="@style/Theme.BiVoca.Home"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".ui.search.VocabularySearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.flashcard.FlashcardActivity"
            android:theme="@style/Theme.BiVoca.Home"
            android:exported="false" />

        <activity
            android:name=".ui.quiz.QuizActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.progress.ProgressActivity"
            android:exported="false" />

        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:exported="false" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsMenuCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">82dp</item><item name="android:layout_marginBottom">12dp</item><item name="android:background">@drawable/settings_card_background</item><item name="android:clickable">true</item><item name="android:focusable">true</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item><item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item>
    </style>
    <style name="SettingsMenuIcon">
        <item name="android:layout_width">44dp</item><item name="android:layout_height">44dp</item><item name="android:background">@drawable/home_icon_background</item><item name="android:gravity">center</item><item name="android:textColor">@color/bivocal_light_cobalt</item><item name="android:textSize">22sp</item><item name="android:textStyle">normal</item><item name="android:importantForAccessibility">no</item>
    <item name="android:fontFamily">@font/be_vietnam_pro_bold</item><item name="fontFamily">@font/be_vietnam_pro_bold</item></style>
    <style name="SettingsMenuText">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:layout_marginStart">14dp</item><item name="android:orientation">vertical</item>
    </style>
    <style name="SettingsMenuTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/bivocal_light_text</item><item name="android:textSize">16sp</item><item name="android:textStyle">normal</item><item name="android:fontFamily">@font/be_vietnam_pro_bold</item><item name="fontFamily">@font/be_vietnam_pro_bold</item></style>
    <style name="SettingsMenuDescription"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">3dp</item><item name="android:textColor">@color/bivocal_light_small_text</item><item name="android:textSize">13sp</item></style>
    <style name="SettingsMenuArrow"><item name="android:layout_width">32dp</item><item name="android:layout_height">48dp</item><item name="android:gravity">center</item><item name="android:text">›</item><item name="android:textColor">@color/bivocal_light_cobalt</item><item name="android:textSize">28sp</item><item name="android:importantForAccessibility">no</item></style>
    <style name="SettingsSectionCard"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginBottom">14dp</item><item name="android:background">@drawable/settings_card_background</item><item name="android:orientation">vertical</item><item name="android:padding">16dp</item></style>
    <style name="SettingsSectionTitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/bivocal_light_text</item><item name="android:textSize">16sp</item><item name="android:textStyle">normal</item><item name="android:fontFamily">@font/be_vietnam_pro_bold</item><item name="fontFamily">@font/be_vietnam_pro_bold</item></style>
    <style name="SettingsSectionDescription"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">5dp</item><item name="android:textColor">@color/bivocal_light_small_text</item><item name="android:textSize">13sp</item></style>
    <style name="SettingsRadioOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/settings_option_background</item>
        <item name="android:buttonTint">@color/settings_control_tint</item>
        <item name="buttonTint">@color/settings_control_tint</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/settings_option_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="SettingsActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/settings_action_text</item>
        <item name="backgroundTint">@color/settings_action_background</item>
        <item name="strokeColor">@color/settings_action_stroke</item>
    </style>
    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/bivocal_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="thumbTint">@color/settings_switch_thumb</item>
        <item name="trackTint">@color/settings_switch_track</item>
    </style>
    <style name="SettingsDayChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/settings_day_chip_background</item>
        <item name="android:button">@drawable/settings_chip_indicator</item>
        <item name="android:buttonTint">@null</item>
        <item name="buttonTint">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/settings_day_chip_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    <item name="android:fontFamily">@font/be_vietnam_pro_bold</item><item name="fontFamily">@font/be_vietnam_pro_bold</item></style>
    <style name="SettingsStatLabel"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:textColor">@color/bivocal_text_secondary</item><item name="android:textSize">14sp</item></style>
    <style name="SettingsStatValue"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">16dp</item><item name="android:textColor">@color/bivocal_cyan_light</item><item name="android:textSize">14sp</item><item name="android:textStyle">normal</item><item name="android:fontFamily">@font/be_vietnam_pro_bold</item><item name="fontFamily">@font/be_vietnam_pro_bold</item></style>
</resources>

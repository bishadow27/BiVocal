<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="phase_c_ground">@color/bivocal_light_canvas</color>
    <color name="phase_c_card">@color/bivocal_light_surface</color>
    <color name="phase_c_border">@color/bivocal_light_border</color>
    <color name="phase_c_blue">@color/bivocal_light_cobalt</color>
    <color name="phase_c_cyan">@color/bivocal_light_cobalt</color>
    <color name="phase_c_text">@color/bivocal_light_text</color>
    <color name="phase_c_secondary">@color/bivocal_light_small_text</color>
    <string name="phase_c_detail_title">Chi tiết chủ đề</string>
    <string name="phase_c_learn_flashcards">Học Flashcard</string>
    <string name="phase_c_quiz">Trắc nghiệm</string>
    <string name="phase_c_preview_title">Xem trước từ vựng</string>
    <string name="phase_c_preview_hint">Một vài từ trong chủ đề</string>
    <string name="phase_c_preview_empty">Chưa có thẻ để xem trước.</string>
    <string name="phase_c_preview_warning">Một số thẻ đang hiển thị chưa được kiểm duyệt ngữ nghĩa.</string>
    <string name="phase_c_retry_metadata">Thử tải lại thông tin</string>
    <string name="phase_c_retry_preview">Thử tải lại từ vựng</string>
    <style name="Theme.BiVoca.TopicDetail" parent="Theme.BiVoca.Home">
        <item name="android:windowBackground">@color/phase_c_ground</item>
        <item name="android:statusBarColor">@color/phase_c_ground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/phase_c_cyan</item>
    </style>
    <style name="PhaseCText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/phase_c_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:includeFontPadding">true</item>
    <item name="fontFamily">@font/be_vietnam_pro</item></style>
    <style name="PhaseCAction" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/phase_c_text</item>
        <item name="backgroundTint">@color/phase_c_blue</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Scoped to the approved Home. Shared M16 resources remain unchanged. -->
    <color name="home_approved_ground">#070B12</color>
    <color name="home_approved_secondary_ground">#0D1320</color>
    <color name="home_approved_card">#121A26</color>
    <color name="home_approved_border">#243246</color>
    <color name="home_approved_blue">#2F6BFF</color>
    <color name="home_approved_blue_dark">#2457E6</color>
    <color name="home_approved_cyan">#22C7F8</color>
    <color name="home_approved_text">#F5F8FC</color>
    <color name="home_approved_secondary_text">#B7C3D4</color>
    <color name="home_approved_tertiary_text">#8FA3BA</color>
    <color name="home_approved_fresh">#4DA3FF</color>
    <color name="home_approved_practicing">#A55CFF</color>
    <color name="home_approved_good">#66E05F</color>
    <color name="home_approved_mastered">#FFC53D</color>
    <string name="home_approved_goal_title">Mục tiêu hôm nay</string>
    <string name="home_approved_goal_percent">%1$d%%</string>
    <string name="home_approved_goal_remaining">Còn %1$d từ để hoàn thành mục tiêu.</string>
    <string name="home_approved_streak">%1$s Day</string>
    <string name="home_approved_srs_title">Độ thuộc từ vựng</string>
    <string name="home_approved_learned">từ đã học</string>
    <string name="home_approved_details">Chi tiết</string>
    <string name="home_approved_all">Tất cả</string>
    <string name="home_approved_self">%1$s · Bạn</string>
    <string name="home_approved_rank_unavailable">Chưa tải được thứ hạng</string>
    <string name="home_approved_not_ranked">Chưa xếp hạng</string>
    <string name="home_approved_rank_description">Hạng %1$s, %2$s, %3$s XP</string>
    <string name="home_approved_brand">BiVocal</string>
    <string name="home_approved_motivation">Mỗi ngày 15 phút, bứt phá vốn từ cùng BiVocal!</string>
    <style name="ApprovedHomeText" parent="Home16Text">
        <item name="android:textColor">@color/home_approved_secondary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">true</item>
    </style>
    <style name="ApprovedHomeTitle" parent="ApprovedHomeText">
        <item name="android:textColor">@color/home_approved_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="ApprovedHomeAction" parent="ApprovedHomeText">
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/home_approved_cyan</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="ApprovedHomeCard" parent="Home16Card">
        <item name="android:layout_marginTop">24dp</item>
        <item name="cardBackgroundColor">@color/home_approved_card</item>
        <item name="strokeColor">@color/home_approved_border</item>
    </style>
    <style name="ApprovedHomeSrsCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="ApprovedHomeSrsLabel" parent="ApprovedHomeText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
    <style name="ApprovedHomeSrsValue" parent="ApprovedHomeTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">end</item>
    </style>
    <style name="Theme.BiVoca.Home.Approved" parent="Theme.BiVoca.Home">
        <item name="android:windowBackground">@color/home_approved_ground</item>
        <item name="android:statusBarColor">@color/home_approved_ground</item>
        <item name="android:navigationBarColor">@color/home_approved_secondary_ground</item>
        <item name="android:colorAccent">@color/home_approved_cyan</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The approved Login and Home share the same palette; other auth screens keep their theme. -->
    <string name="login_approved_title">Đăng nhập</string>
    <string name="login_approved_subtitle">Tiếp tục hành trình học của bạn.</string>
    <string name="login_approved_footer">Chưa có tài khoản? <font color="#087477">Đăng ký ngay</font></string>
    <style name="Theme.BiVoca.Login.Approved" parent="Theme.BiVoca.Login.Reference">
        <item name="android:statusBarColor">@color/home_approved_ground</item>
        <item name="android:navigationBarColor">@color/bivocal_light_system_navigation</item>
        <item name="android:windowBackground">@color/home_approved_ground</item>
        <item name="android:colorAccent">@color/home_approved_cyan</item>
        <item name="colorAccent">@color/home_approved_cyan</item>
    </style>
    <!-- User-requested Google blue background; retain readable dark text and untinted G. -->
    <color name="login_google_brand_surface">#4285F4</color>
    <color name="login_google_brand_text">#1F1F1F</color>
    <color name="login_google_brand_border">#4285F4</color>
</resources>


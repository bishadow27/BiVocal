<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/groupReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<LinearLayout style="@style/SettingsSectionCard" android:background="@drawable/reminder_toggle_background"><com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchReminder" style="@style/SettingsSwitch" android:text="@string/refinement_label_2" android:fontFamily="@font/be_vietnam_pro_semibold"/><TextView android:id="@+id/textReminderStatus" style="@style/SettingsSectionDescription" android:textSize="14sp"/></LinearLayout>
<LinearLayout style="@style/SettingsSectionCard" android:background="@drawable/refinement_card_background"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/home_approved_clock" app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/><TextView style="@style/SettingsSectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/refinement_label_3"/></LinearLayout>
<TimePicker android:id="@+id/pickerReminderTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:timePickerMode="spinner" android:theme="@style/Theme.BiVoca.TimePicker"/>
<com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveReminder" android:layout_width="match_parent" android:layout_height="56dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/refinement_label_4" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/bivocal_light_surface" android:fontFamily="@font/be_vietnam_pro_semibold" app:fontFamily="@font/be_vietnam_pro_semibold" app:backgroundTint="@color/brand_cta" app:cornerRadius="14dp"/>
<TextView android:id="@+id/textReminderFeedback" style="@style/SettingsSectionDescription" android:textSize="14sp" android:accessibilityLiveRegion="polite"/></LinearLayout>
<LinearLayout style="@style/SettingsSectionCard" android:background="@drawable/refinement_card_background"><TextView style="@style/SettingsSectionTitle" android:text="@string/refinement_label_5"/><TextView style="@style/SettingsSectionDescription" android:textSize="14sp" android:text="@string/refinement_label_6"/>

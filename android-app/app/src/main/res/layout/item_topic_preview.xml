<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/phase_c_card" app:strokeColor="@color/phase_c_border" app:strokeWidth="1dp"
    app:cardCornerRadius="@dimen/bivocal_card_radius" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/textPreviewEnglish" style="@style/PhaseCText" android:layout_width="match_parent"
            android:textSize="20sp" android:textColor="@color/phase_c_text" android:fontFamily="@font/be_vietnam_pro_medium"  app:fontFamily="@font/be_vietnam_pro_medium"/>
        <TextView android:id="@+id/textPreviewPronunciation" style="@style/PhaseCText" android:layout_width="match_parent" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/textPreviewVietnamese" style="@style/PhaseCText" android:layout_width="match_parent" android:layout_marginTop="8dp"
            android:textColor="@color/phase_c_text" android:textSize="16sp" />
        <TextView android:id="@+id/textPreviewMetadata" style="@style/PhaseCText" android:layout_width="match_parent" android:layout_marginTop="8dp"
            android:textColor="@color/phase_c_cyan" android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

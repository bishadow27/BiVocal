<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/buttonHomeMenu" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/nav_open_avatar_description"
        android:clickable="true" android:focusable="true">
        <TextView android:id="@+id/textHomeAvatar" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:background="@drawable/home16_avatar" android:gravity="center"
            android:textColor="#F8FAFC" android:textStyle="bold" android:textSize="17sp"/>
        <ImageView android:id="@+id/imageHomeAvatar" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:background="@drawable/avatar_circle_background"
            android:clipToOutline="true" android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone"/>
    </FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/registerRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/login_ui_background">
<ScrollView android:id="@+id/registerScroll" android:layout_width="match_parent" android:layout_height="match_parent"
android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
android:gravity="top" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="24dp"
android:focusableInTouchMode="true">
<include layout="@layout/view_auth_brand_header" />
<TextView style="@style/M16AuthLabel" android:text="@string/auth_full_name_label" android:labelFor="@id/editFullName" android:layout_marginTop="24dp" />
<LinearLayout android:id="@+id/registerFullNameContainer" style="@style/M16AuthField">
<ImageView style="@style/M16AuthIcon" android:src="@drawable/login_user" app:tint="@color/bivocal_text_secondary" />
<EditText android:id="@+id/editFullName" style="@style/M16AuthInput" android:hint="@string/register_full_name_hint"
android:inputType="textPersonName|textCapWords" android:autofillHints="personName" android:imeOptions="actionNext" />

</LinearLayout>
<TextView android:id="@+id/registerFullNameError" style="@style/M16AuthError" /><TextView style="@style/M16AuthLabel" android:text="@string/auth_username_label" android:labelFor="@id/editUsername" />
<LinearLayout android:id="@+id/registerUsernameContainer" style="@style/M16AuthField">
<ImageView style="@style/M16AuthIcon" android:src="@drawable/login_user" app:tint="@color/bivocal_text_secondary" />
<EditText android:id="@+id/editUsername" style="@style/M16AuthInput" android:hint="@string/register_username_hint"
android:inputType="textNoSuggestions" android:autofillHints="username" android:imeOptions="actionNext" />

</LinearLayout>
<TextView android:id="@+id/registerUsernameError" style="@style/M16AuthError" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
android:text="@string/auth_username_helper" android:textColor="@color/bivocal_text_secondary" android:textSize="12sp" /><TextView style="@style/M16AuthLabel" android:text="@string/auth_email_label" android:labelFor="@id/editEmail" />
<LinearLayout android:id="@+id/registerEmailContainer" style="@style/M16AuthField">
<ImageView style="@style/M16AuthIcon" android:src="@drawable/register_mail" app:tint="@color/bivocal_text_secondary" />
<EditText android:id="@+id/editEmail" style="@style/M16AuthInput" android:hint="@string/login_email_hint"
android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext" />

</LinearLayout>
<TextView android:id="@+id/registerEmailError" style="@style/M16AuthError" /><TextView style="@style/M16AuthLabel" android:text="@string/auth_password_label" android:labelFor="@id/editPassword" />
<LinearLayout android:id="@+id/registerPasswordContainer" style="@style/M16AuthField" android:paddingEnd="4dp">
<ImageView style="@style/M16AuthIcon" android:src="@drawable/login_lock" app:tint="@color/bivocal_text_secondary" />
<EditText android:id="@+id/editPassword" style="@style/M16AuthInput" android:hint="@string/login_password_hint"
android:inputType="textPassword" android:autofillHints="newPassword" android:imeOptions="actionNext" />
<ImageButton android:id="@+id/registerTogglePassword" style="@style/M16AuthEye" app:tint="@color/bivocal_text_secondary" />
</LinearLayout>
<TextView android:id="@+id/registerPasswordError" style="@style/M16AuthError" /><TextView style="@style/M16AuthLabel" android:text="@string/auth_confirm_label" android:labelFor="@id/editConfirmPassword" />
<LinearLayout android:id="@+id/registerConfirmContainer" style="@style/M16AuthField" android:paddingEnd="4dp">
<ImageView style="@style/M16AuthIcon" android:src="@drawable/login_lock" app:tint="@color/bivocal_text_secondary" />
<EditText android:id="@+id/editConfirmPassword" style="@style/M16AuthInput" android:hint="@string/register_confirm_hint"
android:inputType="textPassword" android:autofillHints="newPassword" android:imeOptions="actionDone" />
<ImageButton android:id="@+id/registerToggleConfirm" style="@style/M16AuthEye" app:tint="@color/bivocal_text_secondary" />
</LinearLayout>
<TextView android:id="@+id/registerConfirmError" style="@style/M16AuthError" /><TextView android:id="@+id/textError" style="@style/M16AuthError" /><FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonRegister" style="@style/M16AuthPrimary" android:text="@string/auth_register_button" />
<ProgressBar android:id="@+id/progressBar" android:layout_width="20dp" android:layout_height="20dp"
android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp" android:indeterminateTint="@color/bivocal_text_primary" android:visibility="gone" />
</FrameLayout>
<TextView android:id="@+id/textLogin" android:layout_width="match_parent" android:layout_height="wrap_content"
android:minHeight="48dp" android:layout_marginTop="24dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center"
android:background="?attr/selectableItemBackgroundBorderless" android:text="@string/auth_register_footer"
android:textColor="@color/bivocal_text_secondary" android:textSize="14sp" />
</LinearLayout></ScrollView></FrameLayout>

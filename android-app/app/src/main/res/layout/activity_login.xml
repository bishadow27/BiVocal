<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/loginRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/home_approved_ground">
    <ScrollView android:id="@+id/loginScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:focusableInTouchMode="true" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="24dp">
            <LinearLayout android:id="@+id/loginHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/loginMascot" android:layout_width="40dp" android:layout_height="48dp" android:scaleType="fitCenter" android:contentDescription="@string/login_logo_description" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/loginWordmark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_brand" android:textSize="24sp" android:fontFamily="sans-serif" android:textStyle="bold" android:textColor="@color/home_approved_cyan" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="20sp" app:autoSizeMaxTextSize="24sp" app:autoSizeStepGranularity="1sp" />
                        <TextView android:id="@+id/loginSlogan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/login_slogan" android:fontFamily="sans-serif" android:textSize="12sp" android:maxLines="2" android:textColor="@color/home_approved_secondary_text" />
                    </LinearLayout>
                </LinearLayout>
                <View android:id="@+id/loginHeaderDivider" android:layout_width="1dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@color/home_approved_border" android:importantForAccessibility="no" />
                <TextView android:id="@+id/loginHeaderTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/login_approved_title" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/home_approved_text" />
            </LinearLayout>
            <TextView android:id="@+id/loginSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/login_approved_subtitle" android:fontFamily="sans-serif" android:textSize="14sp" android:textColor="@color/home_approved_secondary_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="sans-serif-medium" android:labelFor="@id/editEmail" android:text="@string/login_account_label" android:textColor="@color/home_approved_text" android:textSize="14sp" />
            <LinearLayout android:id="@+id/emailFieldContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/login_approved_field" android:gravity="center_vertical" android:orientation="horizontal" android:minHeight="56dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/register_mail" app:tint="@color/home_approved_secondary_text" />
                <EditText android:id="@+id/editEmail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:autofillHints="emailAddress" android:background="@null" android:fontFamily="sans-serif" android:hint="@string/login_email_hint" android:imeOptions="actionNext" android:inputType="textEmailAddress" android:padding="0dp" android:singleLine="true" android:textColor="@color/home_approved_text" android:textColorHint="@color/home_approved_secondary_text" android:textSize="15sp" android:minHeight="56dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:fontFamily="sans-serif-medium" android:labelFor="@id/editPassword" android:text="@string/login_password_label" android:textColor="@color/home_approved_text" android:textSize="14sp" />
            <LinearLayout android:id="@+id/passwordFieldContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/login_approved_field" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="4dp" android:minHeight="56dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/login_lock" app:tint="@color/home_approved_secondary_text" />
                <EditText android:id="@+id/editPassword" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:autofillHints="password" android:background="@null" android:fontFamily="sans-serif" android:hint="@string/login_password_hint" android:imeOptions="actionDone" android:inputType="textPassword" android:padding="0dp" android:singleLine="true" android:textColor="@color/home_approved_text" android:textColorHint="@color/home_approved_secondary_text" android:textSize="15sp" android:minHeight="56dp" />
                <ImageButton android:id="@+id/buttonTogglePassword" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/login_show_password" android:padding="14dp" android:src="@drawable/login_eye" app:tint="@color/home_approved_secondary_text" />
            </LinearLayout>
            <TextView android:id="@+id/textForgotPassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="4dp" android:layout_gravity="end" android:background="?attr/selectableItemBackgroundBorderless" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="@string/login_forgot_password" android:textColor="@color/home_approved_cyan" android:textSize="13sp" />
            <TextView android:id="@+id/textError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:textColor="@color/bivocal_danger" android:textSize="14sp" android:visibility="gone" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@drawable/login_approved_primary" android:fontFamily="sans-serif-medium" android:text="@string/login_button" android:textAllCaps="false" android:textStyle="normal" android:textColor="@color/home_approved_text" android:textSize="15sp" app:backgroundTint="@null" android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                <ProgressBar android:id="@+id/progressBar" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp" android:indeterminateTint="@color/home_approved_text" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp" android:layout_marginTop="24dp" android:gravity="center" android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/home_approved_border" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="@string/login_or" android:textColor="@color/home_approved_secondary_text" android:textSize="13sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/home_approved_border" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonGoogleSignIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:fontFamily="sans-serif-medium" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/login_google" android:textAllCaps="false" android:textStyle="normal" android:textColor="@color/home_approved_text" android:textSize="15sp" app:backgroundTint="@color/home_approved_ground" app:cornerRadius="12dp" app:icon="@drawable/login_google_g" app:iconGravity="textStart" app:iconPadding="16dp" app:iconSize="20dp" app:iconTint="@null" app:rippleColor="#3338BDF8" app:strokeColor="@color/home_approved_border" app:strokeWidth="1dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <TextView android:id="@+id/textRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:gravity="center" android:text="@string/login_approved_footer" android:textColor="@color/home_approved_secondary_text" android:textSize="13sp" android:paddingTop="8dp" android:paddingBottom="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/login_ui_background">
    <ScrollView android:id="@+id/loginScroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_vertical"
            android:paddingHorizontal="24dp" android:paddingVertical="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="top" android:orientation="horizontal">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/loginMascot" android:layout_width="48dp" android:layout_height="48dp"
                            android:contentDescription="@string/login_logo_description" android:scaleType="fitCenter" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:fontFamily="sans-serif"
                            android:text="@string/login_brand" android:textColor="@color/bivocal_cyan"
                            android:textSize="26sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/loginSlogan"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:gravity="center"
                        android:fontFamily="sans-serif" android:text="@string/login_slogan"
                        android:textColor="@color/bivocal_cyan_light" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="1.5dp" android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="16dp" android:background="@color/bivocal_border"
                    android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:minHeight="48dp"
                    android:gravity="center_vertical" android:fontFamily="sans-serif"
                    android:text="@string/login_heading" android:textColor="@color/bivocal_text_primary"
                    android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:fontFamily="sans-serif-medium"
                android:labelFor="@id/editEmail" android:text="@string/login_account_label"
                android:textColor="@color/bivocal_text_primary" android:textSize="14sp" />
            <LinearLayout android:id="@+id/emailFieldContainer" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/login_ui_field" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingHorizontal="16dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:contentDescription="@null" android:importantForAccessibility="no"
                    android:src="@drawable/register_mail" app:tint="@color/bivocal_text_secondary" />
                <EditText android:id="@+id/editEmail" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginStart="16dp" android:layout_weight="1"
                    android:autofillHints="emailAddress" android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="@string/login_email_hint" android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" android:padding="0dp" android:singleLine="true"
                    android:textColor="@color/bivocal_text_primary"
                    android:textColorHint="@color/bivocal_text_secondary" android:textSize="16sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium" android:labelFor="@id/editPassword"
                android:text="@string/login_password_label" android:textColor="@color/bivocal_text_primary"
                android:textSize="14sp" />
            <LinearLayout android:id="@+id/passwordFieldContainer" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/login_ui_field"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="4dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:contentDescription="@null" android:importantForAccessibility="no"
                    android:src="@drawable/login_lock" app:tint="@color/bivocal_text_secondary" />
                <EditText android:id="@+id/editPassword" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginStart="16dp" android:layout_weight="1"
                    android:autofillHints="password" android:background="@null" android:fontFamily="sans-serif"
                    android:hint="@string/login_password_hint" android:imeOptions="actionDone"
                    android:inputType="textPassword" android:padding="0dp" android:singleLine="true"
                    android:textColor="@color/bivocal_text_primary"
                    android:textColorHint="@color/bivocal_text_secondary" android:textSize="16sp" />
                <ImageButton android:id="@+id/buttonTogglePassword" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/login_show_password" android:padding="14dp"
                    android:src="@drawable/login_eye" app:tint="@color/bivocal_text_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/textForgotPassword" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_marginTop="6dp" android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-medium" android:gravity="center"
                android:text="@string/login_forgot_password" android:textColor="@color/bivocal_cyan"
                android:textSize="14sp" />
            <TextView android:id="@+id/textError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"
                android:textColor="@color/bivocal_danger" android:textSize="14sp" android:visibility="gone" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonLogin"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                    android:background="@drawable/login_ui_primary" android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="40dp" android:paddingVertical="12dp"
                    android:text="@string/login_button" android:textAllCaps="false"
                    android:textStyle="normal"
                    android:textColor="@color/bivocal_text_primary" android:textSize="16sp" app:backgroundTint="@null" />
                <ProgressBar android:id="@+id/progressBar" android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
                    android:indeterminateTint="@color/bivocal_text_primary" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp"
                android:layout_marginTop="20dp" android:gravity="center" android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="@color/login_ui_border" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp" android:text="@string/login_or"
                    android:textColor="@color/bivocal_text_secondary" android:textSize="14sp" />
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="@color/login_ui_border" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonGoogleSignIn"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                android:layout_marginTop="16dp" android:fontFamily="sans-serif-medium"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                android:text="@string/login_google" android:textAllCaps="false"
                android:textStyle="normal"
                android:textColor="@color/bivocal_text_primary" android:textSize="16sp"
                app:backgroundTint="@color/login_ui_input" app:cornerRadius="12dp"
                app:icon="@drawable/login_google_g" app:iconGravity="textStart" app:iconPadding="16dp"
                app:iconSize="20dp" app:iconTint="@null" app:rippleColor="#3338BDF8"
                app:strokeColor="@color/login_ui_border" app:strokeWidth="1dp" />
            <TextView android:id="@+id/textRegister" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_marginTop="32dp" android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center" android:text="@string/login_footer"
                android:textColor="@color/bivocal_text_secondary" android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

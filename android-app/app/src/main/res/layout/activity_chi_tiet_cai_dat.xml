<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsDetailRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/login_night_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/buttonSettingsBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Quay lại Cài đặt" android:gravity="center" android:text="‹" android:textColor="@color/bivocal_light_cobalt" android:textSize="34sp"/>
        <TextView android:visibility="gone" android:id="@+id/textSettingsTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="@color/bivocal_light_text" android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="10dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
            <TextView android:id="@+id/textSettingsSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:textColor="@color/bivocal_light_small_text" android:textSize="14sp"/>

            <LinearLayout android:id="@+id/groupStudy" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout style="@style/SettingsSectionCard"><TextView style="@style/SettingsSectionTitle" android:text="Mục tiêu học mỗi ngày"/><TextView android:id="@+id/textDailyGoalValue" style="@style/SettingsSectionDescription"/><RadioGroup android:id="@+id/radioDailyGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"><RadioButton android:id="@+id/goal5" style="@style/SettingsRadioOption" android:text="5 từ mới/ngày"/><RadioButton android:id="@+id/goal10" style="@style/SettingsRadioOption" android:text="10 từ mới/ngày"/><RadioButton android:id="@+id/goal15" style="@style/SettingsRadioOption" android:text="15 từ mới/ngày"/><RadioButton android:id="@+id/goal20" style="@style/SettingsRadioOption" android:text="20 từ mới/ngày"/></RadioGroup></LinearLayout>
                <LinearLayout style="@style/SettingsSectionCard"><TextView style="@style/SettingsSectionTitle" android:text="Mặt trước Flashcard"/><TextView style="@style/SettingsSectionDescription" android:text="Chọn ngôn ngữ bạn muốn nhìn thấy trước khi lật thẻ."/><RadioGroup android:id="@+id/radioFlashcardFront" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><RadioButton android:id="@+id/frontEnglish" style="@style/SettingsRadioOption" android:text="Tiếng Anh trước"/><RadioButton android:id="@+id/frontVietnamese" style="@style/SettingsRadioOption" android:text="Tiếng Việt trước"/></RadioGroup></LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/groupAudio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout style="@style/SettingsSectionCard"><com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAutoPronunciation" style="@style/SettingsSwitch" android:text="Tự động phát âm từ vựng"/><TextView style="@style/SettingsSectionDescription" android:text="Đọc từ tiếng Anh một lần khi chuyển sang thẻ mới."/></LinearLayout>
                <LinearLayout style="@style/SettingsSectionCard"><TextView style="@style/SettingsSectionTitle" android:text="Tốc độ phát âm"/><RadioGroup android:id="@+id/radioSpeechRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><RadioButton android:id="@+id/rateSlow" style="@style/SettingsRadioOption" android:text="0.8x · Chậm"/><RadioButton android:id="@+id/rateNormal" style="@style/SettingsRadioOption" android:text="1.0x · Bình thường"/><RadioButton android:id="@+id/rateFast" style="@style/SettingsRadioOption" android:text="1.2x · Nhanh"/></RadioGroup></LinearLayout>
            </LinearLayout>

            <include layout="@layout/view_settings_reminder"/>

            <LinearLayout android:id="@+id/groupAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout style="@style/SettingsSectionCard" android:gravity="center_horizontal"><ImageView android:layout_width="230dp" android:layout_height="96dp" android:adjustViewBounds="true" android:contentDescription="Logo BiVocal" android:scaleType="centerInside" android:src="@drawable/bivocal_wordmark"/><TextView style="@style/SettingsSectionTitle" android:gravity="center" android:text="BiVocal" android:textSize="22sp"/><TextView style="@style/SettingsSectionDescription" android:gravity="center" android:text="Ứng dụng học từ vựng tiếng Anh bằng Flashcard, Quiz và ôn tập ngắt quãng."/><TextView android:id="@+id/textAppVersion" style="@style/SettingsSectionDescription" android:gravity="center"/><TextView style="@style/SettingsSectionDescription" android:layout_marginTop="16dp" android:autoLink="web" android:gravity="center" android:linksClickable="true" android:text="Ngữ liệu Anh–Việt được BiVocal lọc, phân loại và tích hợp từ Skypedia English-Vietnamese Dictionary, dựa trên MinhQND Dictionary. Dữ liệu phái sinh theo CC BY-SA 4.0. Nguồn và giấy phép: https://github.com/skypediacode/english-vietnamese-dictionary"/></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

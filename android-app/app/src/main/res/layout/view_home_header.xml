<?xml version="1.0" encoding="utf-8"?>
<!-- Give the slogan a full row at narrow widths and larger font settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/homeTopBar"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="24dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/homeHeaderMascot" android:layout_width="32dp" android:layout_height="40dp" android:scaleType="fitCenter" android:contentDescription="@string/login_logo_description"/>
        <TextView style="@style/ApprovedHomeTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/home_approved_brand" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/home_approved_cyan"/>
        <include layout="@layout/view_home_header_actions"/>
    </LinearLayout>
    <TextView android:id="@+id/textHomeSlogan" style="@style/ApprovedHomeText" android:layout_width="match_parent" android:layout_marginTop="4dp"
        android:text="@string/home_approved_motivation" android:textSize="12sp" android:maxLines="2"/>
</LinearLayout>

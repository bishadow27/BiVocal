<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/home_approved_ground">
    <include layout="@layout/view_home_header"/>
    <ScrollView android:id="@+id/homeScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="16dp">
            <TextView android:id="@+id/textHomeSlogan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_approved_motivation" android:fontFamily="@font/be_vietnam_pro_extrabold" android:textSize="26sp" android:textColor="@color/bivocal_light_text" android:includeFontPadding="true" android:lineSpacingExtra="3dp" android:layout_marginBottom="24dp" app:fontFamily="@font/be_vietnam_pro_extrabold"/>
            <ProgressBar android:id="@+id/progressHomeLoading" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center_horizontal" android:indeterminateTint="@color/home_approved_cyan" android:visibility="gone"/>
            <LinearLayout android:id="@+id/homeErrorContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp"
                android:padding="12dp" android:background="@drawable/home_error_background" android:visibility="gone">
                <TextView android:id="@+id/textHomeError" style="@style/ApprovedHomeText" android:layout_width="0dp" android:layout_weight="1" android:textColor="@color/bivocal_light_coral_ink"/>
                <TextView android:id="@+id/buttonHomeRetry" style="@style/ApprovedHomeAction" android:text="@string/home_retry"/>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardDailyGoal" style="@style/ApprovedHomeCard"
                android:layout_marginTop="0dp" app:cardBackgroundColor="@color/bivocal_light_mint_soft" app:strokeWidth="1dp" app:cardCornerRadius="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView style="@style/ApprovedHomeTitle" android:text="@string/home_approved_goal_title"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/textDailyGoal" style="@style/ApprovedHomeTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/home_placeholder" android:textSize="32sp"/>
                        <TextView android:id="@+id/textDailyGoalPercent" style="@style/ApprovedHomeTitle" android:layout_marginStart="8dp" android:text="@string/home_placeholder" android:textSize="18sp"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/progressDailyGoal" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp"
                        android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/home_approved_progress"/>
                    <TextView android:id="@+id/textDailyGoalStatus" style="@style/ApprovedHomeText" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="@string/home16_loading"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonLearnNewToday" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="52dp" android:layout_marginTop="12dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:insetTop="0dp" android:insetBottom="0dp" android:background="@drawable/light_home_goal_action" android:backgroundTint="@null" app:backgroundTint="@null"
                        android:text="@string/home16_learn" android:textAllCaps="false" android:textSize="15sp" android:fontFamily="@font/be_vietnam_pro_medium" android:textColor="@color/bivocal_light_on_primary"
                        app:icon="@drawable/home_approved_arrow" app:iconGravity="textEnd" app:iconPadding="12dp" app:iconSize="20dp" app:iconTint="@color/bivocal_light_on_primary" app:fontFamily="@font/be_vietnam_pro_medium"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <include layout="@layout/view_home_srs"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomeLeaderboard" style="@style/ApprovedHomeCard"
                app:cardBackgroundColor="@color/home_approved_ground" app:strokeWidth="0dp" app:cardCornerRadius="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ApprovedHomeTitle" android:layout_width="match_parent" android:text="@string/home16_leaderboard"/>
                            <TextView style="@style/ApprovedHomeText" android:layout_width="match_parent" android:layout_marginTop="3dp" android:text="@string/home16_leaderboard_scope"/>
                        </LinearLayout>
                        <TextView android:id="@+id/buttonLeaderboard" style="@style/ApprovedHomeAction" android:layout_marginStart="8dp" android:text="@string/home_approved_all"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/homeLeaderboardRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
                    <LinearLayout android:id="@+id/homeCurrentUserRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical"/>
                    <TextView android:id="@+id/textHomeLeaderboardState" style="@style/ApprovedHomeText" android:layout_width="match_parent" android:layout_marginTop="8dp" android:text="@string/home16_loading"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/home_approved_border"/>
    <include layout="@layout/view_learning_bottom_navigation"/>
</LinearLayout>

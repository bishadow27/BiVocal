<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/login_night_background">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/buttonProfileBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_open_description"
            android:text="@string/nav_back_symbol"
            android:textColor="@color/bivocal_light_cobalt"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textProfileTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hồ sơ cá nhân"
            android:textColor="@color/bivocal_light_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- Trạng thái Loading -->
    <ProgressBar
        android:id="@+id/progressProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:contentDescription="Đang tải thông tin"
        android:visibility="gone" />

    <!-- Trạng thái Lỗi -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginTop="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textProfileError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/bivocal_light_coral_ink"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProfileRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Thử lại"
            app:backgroundTint="@color/bivocal_light_cobalt"  android:textColor="@color/bivocal_light_on_primary"/>
    </LinearLayout>

    <!-- Nội dung chính -->
    <ScrollView
        android:id="@+id/scrollProfileContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Thông tin cá nhân -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bivocal_light_surface"
                app:cardCornerRadius="@dimen/bivocal_card_radius"
                app:cardElevation="1dp"
                app:strokeColor="@color/bivocal_light_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp">
                        <ImageView
                            android:id="@+id/imageProfileAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/avatar_circle_background"
                            android:clipToOutline="true"
                            android:contentDescription="Ảnh đại diện"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/textAvatarLetter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/avatar_circle_background"
                            android:gravity="center"
                            android:text="U"
                            android:textColor="@color/bivocal_light_text"
                            android:textSize="32sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonChooseAvatar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Đổi ảnh đại diện"
                        android:textColor="@color/bivocal_light_cobalt" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonResetAvatar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dùng avatar mặc định"
                        android:textColor="@color/bivocal_light_small_text"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/avatarPreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/dark_card_background"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/imageAvatarPreview"
                            android:layout_width="112dp"
                            android:layout_height="112dp"
                            android:background="@drawable/avatar_circle_background"
                            android:clipToOutline="true"
                            android:contentDescription="Xem trước ảnh đại diện"
                            android:scaleType="centerCrop" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonCancelAvatar"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hủy" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonConfirmAvatar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lưu ảnh"
                                app:backgroundTint="@color/bivocal_light_cobalt"  android:textColor="@color/bivocal_light_on_primary"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Ảnh chỉ lưu trên thiết bị này"
                        android:textColor="@color/bivocal_light_small_text"
                        android:textSize="12sp" />

                    <!-- Họ và tên -->
                    <TextView
                        android:id="@+id/textFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/bivocal_light_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Username -->
                    <TextView
                        android:id="@+id/textUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/bivocal_light_small_text"
                        android:textSize="14sp" />

                    <!-- Email -->
                    <TextView
                        android:id="@+id/textEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/bivocal_light_small_text"
                        android:textSize="14sp" />

                    <!-- Cấp độ người học -->
                    <TextView
                        android:id="@+id/textLevelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/bivocal_light_cobalt_soft"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/bivocal_light_cobalt"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tiêu đề phần Gamification -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Thành tích học tập"
                android:textColor="@color/bivocal_light_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Khối Gamification: 3 thẻ xếp ngang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Thẻ 1: Tổng XP -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/bivocal_light_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/bivocal_light_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/home_approved_quiz"
                              app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/textTotalXp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/bivocal_light_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tổng XP"
                            android:textColor="@color/bivocal_light_small_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ 2: Chuỗi Streak hiện tại -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:cardBackgroundColor="@color/bivocal_light_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/bivocal_light_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/home_approved_flame"
                              app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/textCurrentStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/bivocal_light_honey_ink"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Streak ngày"
                            android:textColor="@color/bivocal_light_small_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ 3: Kỷ lục Streak -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/bivocal_light_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/bivocal_light_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/home_approved_quiz"
                              app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/>

                        <TextView
                            android:id="@+id/textLongestStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/bivocal_light_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Kỷ lục"
                            android:textColor="@color/bivocal_light_small_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLinkGoogle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="56dp"
                android:text="@string/profile_link_google"
                android:textColor="@color/bivocal_light_text"
                android:textSize="16sp"
                app:strokeColor="@color/bivocal_light_small_text" />

            <!-- Nút Đăng xuất -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonProfileLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp"
                android:text="Đăng xuất"
                android:textColor="@color/bivocal_light_coral_ink"
                android:textSize="16sp"
                app:strokeColor="@color/bivocal_light_coral_ink" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>



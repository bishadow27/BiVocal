<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/login_night_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
            <TextView android:id="@+id/buttonSettingsMenu" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:contentDescription="@string/nav_open_description" android:gravity="center" android:text="@string/nav_back_symbol"/>
        </FrameLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="16dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
                <LinearLayout android:id="@+id/settingsStudy" style="@style/RefinedSettingsMenuCard" android:contentDescription="Học tập"><ImageView style="@style/SettingsMenuIcon" android:src="@drawable/topics16_book" android:scaleType="center" app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Học tập"/><TextView style="@style/SettingsMenuDescription" android:text="Mục tiêu hằng ngày và Flashcard"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsAudio" style="@style/RefinedSettingsMenuCard" android:contentDescription="Âm thanh"><ImageView style="@style/SettingsMenuIcon" android:src="@drawable/ic_flashcard_speaker" android:scaleType="center" app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Âm thanh"/><TextView style="@style/SettingsMenuDescription" android:text="Phát âm và tốc độ đọc"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsReminder" style="@style/RefinedSettingsMenuCard" android:contentDescription="Nhắc học"><ImageView style="@style/SettingsMenuIcon" android:src="@drawable/home_approved_clock" android:scaleType="center" app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Nhắc học"/><TextView style="@style/SettingsMenuDescription" android:text="Lịch nhắc học mỗi ngày"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsAbout" style="@style/RefinedSettingsMenuCard" android:contentDescription="Giới thiệu"><ImageView style="@style/SettingsMenuIcon" android:src="@drawable/auth_info" android:scaleType="center" app:tint="@color/bivocal_light_cobalt" android:importantForAccessibility="no"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Giới thiệu"/><TextView style="@style/SettingsMenuDescription" android:text="Phiên bản và thông tin ứng dụng"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>


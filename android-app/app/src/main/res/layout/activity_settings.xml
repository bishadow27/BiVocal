<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/login_night_background">
    <ImageView android:layout_width="62dp" android:layout_height="62dp" android:layout_gravity="top|end" android:layout_marginTop="62dp" android:layout_marginEnd="46dp" android:importantForAccessibility="no" android:src="@drawable/login_moon"/>
    <ImageView android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="38dp" android:layout_marginTop="190dp" android:importantForAccessibility="no" android:src="@drawable/login_star"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp">
            <TextView android:id="@+id/buttonSettingsMenu" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:contentDescription="@string/nav_open_description" android:gravity="center" android:text="@string/nav_back_symbol"/>
        </FrameLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CÀI ĐẶT" android:textColor="#F8FAFC" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="20dp" android:text="Điều chỉnh trải nghiệm học tập theo cách của bạn." android:textColor="#94A3B8" android:textSize="14sp"/>
                <LinearLayout android:id="@+id/settingsStudy" style="@style/SettingsMenuCard" android:contentDescription="Học tập"><TextView style="@style/SettingsMenuIcon" android:text="▤"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Học tập"/><TextView style="@style/SettingsMenuDescription" android:text="Mục tiêu hằng ngày và Flashcard"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsAudio" style="@style/SettingsMenuCard" android:contentDescription="Âm thanh"><TextView style="@style/SettingsMenuIcon" android:text="♪"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Âm thanh"/><TextView style="@style/SettingsMenuDescription" android:text="Phát âm và tốc độ đọc"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsReminder" style="@style/SettingsMenuCard" android:contentDescription="Nhắc học"><TextView style="@style/SettingsMenuIcon" android:text="◉"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Nhắc học"/><TextView style="@style/SettingsMenuDescription" android:text="Lịch nhắc học mỗi ngày"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsDisplay" style="@style/SettingsMenuCard" android:contentDescription="Giao diện"><TextView style="@style/SettingsMenuIcon" android:text="A"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Giao diện"/><TextView style="@style/SettingsMenuDescription" android:text="Kích thước chữ và hiệu ứng"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
                <LinearLayout android:id="@+id/settingsAbout" style="@style/SettingsMenuCard" android:contentDescription="Giới thiệu"><TextView style="@style/SettingsMenuIcon" android:text="i"/><LinearLayout style="@style/SettingsMenuText"><TextView style="@style/SettingsMenuTitle" android:text="Giới thiệu"/><TextView style="@style/SettingsMenuDescription" android:text="Phiên bản và thông tin ứng dụng"/></LinearLayout><TextView style="@style/SettingsMenuArrow"/></LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>


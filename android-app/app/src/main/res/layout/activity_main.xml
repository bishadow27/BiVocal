<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bivocal_light_text">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BiVoca"
            android:textColor="@color/bivocal_light_cobalt"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Học tiếng Anh dễ hơn mỗi ngày"
            android:textColor="@color/bivocal_light_small_text"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đăng nhập"
            android:textColor="@color/bivocal_light_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/edit_text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="14dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bivocal_light_coral_ink"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginTop="10dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Đăng nhập"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có tài khoản? Đăng ký"
            android:textColor="@color/bivocal_light_cobalt"
            android:textSize="14sp"
            android:layout_marginTop="22dp" />

    </LinearLayout>

</ScrollView>
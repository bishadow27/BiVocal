<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/homeRank" style="@style/ApprovedHomeTitle" android:layout_width="24dp" android:gravity="center" android:textSize="14sp"/>
    <TextView android:id="@+id/homeRankAvatar" style="@style/ApprovedHomeTitle" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/home_approved_avatar" android:textSize="14sp" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/homeRankName" style="@style/ApprovedHomeText" android:layout_width="match_parent" android:textSize="14sp" android:textColor="@color/home_approved_text" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/homeRankMeta" style="@style/ApprovedHomeText" android:layout_width="match_parent" android:textSize="12sp" android:textColor="@color/home_approved_tertiary_text" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/homeRankXp" style="@style/ApprovedHomeTitle" android:layout_marginStart="8dp" android:gravity="end" android:textSize="14sp" android:textColor="@color/home_approved_secondary_text"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/forgotRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/login_ui_background">
<ScrollView android:id="@+id/forgotScroll" android:layout_width="match_parent" android:layout_height="match_parent"
android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
android:gravity="top" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="24dp"
android:focusableInTouchMode="true">
<include layout="@layout/view_auth_brand_header" />


<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
android:gravity="start" android:text="@string/auth_recovery_instruction" android:textColor="@color/bivocal_text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
android:layout_marginTop="16dp" android:orientation="horizontal" android:padding="16dp" android:background="@drawable/auth_google_callout">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/auth_info"
android:importantForAccessibility="no" android:contentDescription="@null" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
android:text="@string/auth_google_help_title" android:fontFamily="@font/be_vietnam_pro_medium" android:textSize="14sp" android:textColor="@color/bivocal_text_primary"  app:fontFamily="@font/be_vietnam_pro_medium"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
android:text="@string/auth_google_help_body" android:textSize="14sp" android:textColor="@color/bivocal_text_secondary" android:lineSpacingExtra="3dp" />
</LinearLayout>
</LinearLayout>
<TextView style="@style/M16AuthLabel" android:layout_marginTop="24dp" android:labelFor="@id/forgotEditEmail" android:text="@string/login_email_label" />
<LinearLayout android:id="@+id/forgotEmailFieldContainer" style="@style/M16AuthField">
<ImageView style="@style/M16AuthIcon" android:src="@drawable/register_mail" app:tint="@color/bivocal_text_secondary" />
<EditText android:id="@+id/forgotEditEmail" style="@style/M16AuthInput" android:hint="@string/auth_recovery_email_hint"
android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionDone" />
</LinearLayout>
<TextView android:id="@+id/forgotFeedback" style="@style/M16AuthError" />
<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/forgotButtonSubmit" style="@style/M16AuthPrimary" android:text="@string/forgot_submit" />
<ProgressBar android:id="@+id/forgotProgressBar" android:layout_width="20dp" android:layout_height="20dp"
android:layout_gravity="center_vertical|start" android:layout_marginStart="12dp" android:indeterminateTint="@color/bivocal_text_primary" android:visibility="gone" />
</FrameLayout>

<com.google.android.material.button.MaterialButton android:id="@+id/forgotBackLogin" android:layout_width="match_parent"
android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="24dp"
android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
android:text="@string/auth_return_login" android:textAllCaps="false" android:textSize="16sp" android:textStyle="normal"
android:fontFamily="@font/be_vietnam_pro_medium" android:textColor="@color/bivocal_text_primary"
app:backgroundTint="@color/login_ui_input" app:cornerRadius="12dp" app:strokeWidth="1dp" app:strokeColor="@color/login_ui_border"
app:icon="@drawable/auth_arrow_back" app:iconTint="@color/bivocal_text_primary" app:iconGravity="textStart" app:iconSize="24dp" app:iconPadding="12dp"  app:fontFamily="@font/be_vietnam_pro_medium"/>
</LinearLayout></ScrollView></FrameLayout>

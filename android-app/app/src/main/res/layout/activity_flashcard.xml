<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/flashcardScreenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bivocal_light_canvas">
<androidx.core.widget.NestedScrollView android:id="@+id/flashcardPageScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:background="@color/bivocal_light_canvas">
<LinearLayout android:id="@+id/flashcardRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/buttonFlashcardBack" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/fc16_back" android:contentDescription="@string/nav_back_description"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="56dp" android:layout_marginEnd="56dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/textTopicTitle" style="@style/Fc16Title" android:layout_width="match_parent" android:gravity="center" android:textSize="22sp"/>
            <TextView android:id="@+id/textPosition" style="@style/Fc16Text" android:gravity="center" android:textSize="14sp" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/textSessionMode" style="@style/Fc16Text" android:textColor="@color/bivocal_light_cobalt" android:textSize="11sp" android:layout_marginTop="6dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:gravity="center" android:background="@drawable/fc16_chip"/>
        </LinearLayout>
        <ImageButton android:id="@+id/buttonFlashcardMenu" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/fc16_more" android:contentDescription="@string/fc16_menu"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/textSessionProgressLabel" style="@style/Fc16Text" android:layout_width="0dp" android:layout_weight="1" android:textSize="14sp" android:text="@string/fc16_progress"/>
            <TextView android:id="@+id/textSessionProgress" style="@style/Fc16Text" android:textSize="14sp"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/progressSession" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="100" android:progressDrawable="@drawable/phase_d_progress"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/bivocal_light_cobalt_soft"/>
    <FrameLayout android:id="@+id/flashcardViewport" android:layout_width="match_parent" android:layout_height="320dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="48dp" android:layout_marginBottom="12dp">
        <com.google.android.material.card.MaterialCardView android:id="@+id/flashcardContent" android:layout_width="match_parent" android:layout_height="match_parent" app:cardBackgroundColor="@color/bivocal_light_surface" app:cardCornerRadius="@dimen/bivocal_card_radius" app:strokeColor="@color/bivocal_light_border" app:strokeWidth="1dp" app:cardElevation="0dp" android:visibility="gone">
            <ScrollView android:id="@+id/flashcardInnerScroll" android:nestedScrollingEnabled="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
                    <LinearLayout android:id="@+id/layoutCardFront" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/textEnglish" style="@style/Fc16Title" android:layout_width="match_parent" android:textSize="36sp" android:gravity="center"/>
                        <TextView android:id="@+id/textPronunciation" style="@style/Fc16Text" android:layout_marginTop="12dp" android:textSize="16sp" android:gravity="center"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonSpeak" style="@style/Fc16Audio" android:layout_marginTop="12dp" android:contentDescription="@string/fc16_word_audio"/>
                        <TextView android:id="@+id/textMetadata" style="@style/Fc16Text" android:layout_marginTop="20dp" android:background="@drawable/fc16_chip" android:padding="8dp" android:gravity="center"/>
                        <TextView android:id="@+id/textCardFrontHint" style="@style/Fc16Text" android:layout_width="match_parent" android:layout_marginTop="48dp" android:gravity="center"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layoutCardBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/textBackWord" style="@style/Fc16Title" android:textSize="30sp"/>
                                <TextView android:id="@+id/textBackPronunciation" style="@style/Fc16Text" android:textSize="16sp" android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSpeakBack" style="@style/Fc16Audio" android:contentDescription="@string/fc16_word_audio"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@color/bivocal_light_border"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:orientation="vertical">
                                <TextView android:id="@+id/textCardBackLabel" style="@style/Fc16Text" android:textStyle="bold"/>
                                <TextView android:id="@+id/textVietnamese" style="@style/Fc16Title" android:layout_width="match_parent" android:textSize="24sp" android:layout_marginTop="6dp"/>
                            </LinearLayout>
                            <LinearLayout android:id="@+id/flashcardMetadataColumn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="end">
                                <TextView android:id="@+id/textBackMetadataLabel" style="@style/Fc16Text" android:layout_width="match_parent" android:gravity="end" android:text="@string/fc16_metadata" android:textStyle="bold"/>
                                <TextView android:id="@+id/textBackMetadata" style="@style/Fc16Text" android:background="@drawable/fc16_chip" android:padding="8dp" android:gravity="end" android:layout_marginTop="6dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/exampleSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
                            <TextView style="@style/Fc16Text" android:text="@string/fc16_example" android:textStyle="bold"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="8dp" android:background="@drawable/light_example_panel">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                    <TextView android:id="@+id/textExample" style="@style/Fc16Title" android:layout_width="0dp" android:layout_weight="1" android:textStyle="normal" android:textSize="16sp" android:lineSpacingExtra="3dp"/>
                                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonSpeakExample" style="@style/Fc16Audio" android:contentDescription="@string/fc16_example_audio"/>
                                </LinearLayout>
                                <TextView android:id="@+id/textExampleVi" style="@style/Fc16Text" android:layout_width="match_parent" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/textCardBackHint" style="@style/Fc16Text" android:layout_width="match_parent" android:gravity="center" android:layout_marginTop="20dp"/>
                    </LinearLayout>
                </FrameLayout>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:id="@+id/flashcardState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
            <ProgressBar android:id="@+id/progressFlashcards" android:layout_width="36dp" android:layout_height="36dp" android:indeterminateTint="@color/bivocal_light_cobalt" android:visibility="gone"/>
            <TextView android:id="@+id/textFlashcardError" style="@style/Fc16Text" android:layout_width="match_parent" android:gravity="center" android:textColor="@color/bivocal_light_coral_ink" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonRetryFlashcards" style="@style/Fc16Button" android:text="@string/online_retry" android:visibility="gone"/>
            <TextView android:id="@+id/textFlashcardEmpty" style="@style/Fc16Text" android:layout_width="match_parent" android:gravity="center" android:text="@string/flashcard_empty" android:visibility="gone"/>
        </LinearLayout>
        <include layout="@layout/view_flashcard_complete"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/flashcardControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPrevious" style="@style/Fc16Button" android:layout_width="52dp" android:minWidth="52dp" android:text="@string/fc16_previous" android:textSize="24sp" android:contentDescription="@string/flashcard_previous" app:cornerRadius="26dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonFlipCard" style="@style/Fc16Primary" android:minHeight="64dp" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:text="@string/fc16_flip"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonNext" style="@style/Fc16Button" android:layout_width="52dp" android:minWidth="52dp" android:text="@string/fc16_next" android:textSize="24sp" android:contentDescription="@string/flashcard_next" app:cornerRadius="26dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/reviewSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone">
            <TextView style="@style/Fc16Title" android:layout_width="match_parent" android:gravity="center" android:text="@string/fc16_question" android:textSize="14sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonNotRemember" style="@style/Fc16Button" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:minHeight="56dp" android:text="@string/fc16_not_remembered" android:textColor="@color/bivocal_light_honey_ink" app:strokeColor="@color/bivocal_light_honey_ink"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonRemembered" style="@style/Fc16Button" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="5dp" android:minHeight="56dp" android:text="@string/fc16_remembered" android:textColor="@color/bivocal_light_mint_ink" app:strokeColor="@color/bivocal_light_mint_ink"/>
            </LinearLayout>
        </LinearLayout>

            <TextView android:id="@+id/textReviewError" style="@style/Fc16Text" android:layout_width="match_parent" android:textColor="@color/bivocal_light_coral_ink" android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
        <TextView android:id="@+id/textSpeechStatus" style="@style/Fc16Text" android:layout_width="match_parent" android:gravity="center" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/textCardSideBadge" style="@style/Fc16Text" android:visibility="gone"/>
    <TextView android:id="@+id/buttonFavorite" style="@style/Fc16Text" android:visibility="gone"/>
    <TextView android:id="@+id/buttonStartQuiz" style="@style/Fc16Text" android:visibility="gone"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
<include layout="@layout/view_learning_bottom_navigation"/>
</LinearLayout>

{
  "name": "english-flashcard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/database.integration.ts",
    "test:auth:integration": "tsx --test tests/auth.database.integration.ts",
    "test:progress:integration": "tsx --test tests/progress.database.integration.ts",
    "test:quiz:integration": "tsx --test tests/quiz.database.integration.ts",
    "test:gamification:integration": "tsx --test tests/gamification.database.integration.ts",
    "test:admin:integration": "tsx --test tests/admin.database.integration.ts",
    "test:m13:integration": "tsx --test tests/m13-large.database.integration.ts",
    "test:m13-6:integration": "tsx --test tests/m13-6.database.integration.ts",
    "test:m14:integration": "tsx --test tests/m14.database.integration.ts",
    "test:m15:integration": "tsx --test tests/m15.database.integration.ts",
    "test:m15-5:integration": "tsx --test tests/m15-5.database.integration.ts",
    "smtp:verify": "tsx scripts/verify-smtp.ts",
    "admin:set-role": "tsx scripts/set-user-role.ts",
    "cefr:audit": "tsx scripts/import-cefr.ts --dry-run",
    "cefr:import:test": "tsx scripts/import-cefr.ts --apply",
    "vocab:build": "python scripts/large_vocabulary_pipeline.py --target-total 5000",
    "vocab:audit-source": "python scripts/audit_en_vi_source.py",
    "vocab:import:dry-run": "tsx scripts/import-large-vocabulary.ts --dry-run",
    "vocab:import:test": "tsx scripts/import-large-vocabulary.ts --apply",
    "vocab:review:load": "tsx scripts/load-vocabulary-review-candidates.ts --dry-run",
    "vocab:plan:m15-5-unverified": "tsx scripts/prepare-m15-5-unverified-plan.ts",
    "vocab:import:m15-5-unverified": "tsx scripts/import-m15-5-unverified.ts",
    "vocab:verify:m15-5-production": "tsx scripts/verify-m15-5-production.ts",
    "topics:classify:m15-6": "tsx scripts/classify-m15-6-topics.ts",
    "topics:verify:m15-6": "tsx scripts/verify-m15-6-topics.ts",
    "topics:classify:m15-7": "tsx scripts/classify-m15-7-semantic-topics.ts",
    "topics:verify:m15-7": "tsx scripts/verify-m15-7-topics.ts",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:create": "node-pg-migrate create --migration-file-language sql --migrations-dir migrations"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
